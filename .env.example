# Client onboarding form (/onboard). Copy to .env.local for local use and set
# the same names in Vercel: Project > Settings > Environment Variables.
# Never commit real values.

# Long random string that signs the form links (npm run link). Changing it
# invalidates every link, the universal one included.
FORM_LINK_SECRET=
# Address that receives the client briefs.
NOTIFY_EMAIL=
# Gmail account that sends them, and its 16-character Google App Password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Your site's address, used by npm run link to print the link (e.g. https://taply.example).
SITE_URL=
